{
  "project": {
    "id": "ohio_cdl_edge_dynamics_v001",
    "created": "2026-07-06"
  },
  "aoi": {
    "path": "inputs/aoi.geojson",
    "input_crs": "EPSG:4326",
    "bbox_policy": "tile_to_source_limits"
  },
  "target_grid": {
    "crs": "EPSG:5070",
    "resolution_m": 30,
    "snap": "aoi_bounds",
    "nodata": 255
  },
  "sources": [
    {
      "id": "cdl",
      "registry_key": "usda_nass_cdl_imageserver",
      "years": [2023, 2024],
      "thematic_layers": ["crop_type"],
      "acquisition_mode": "arcgis_export_image",
      "semantic_type": "categorical",
      "resampling": "nearest"
    }
  ],
  "outputs": {
    "manifest_dir": "manifests",
    "plan_dir": "plans",
    "raster_format": "COG"
  }
}
