{
  "$id": "https://fasterraster.local/schemas/data_task.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aoi": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "bbox_crs": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "bbox",
        "bbox_crs"
      ],
      "type": "object"
    },
    "description": {
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "preview": {
      "additionalProperties": false,
      "properties": {
        "color_scheme": {
          "enum": [
            "default"
          ],
          "type": "string"
        },
        "open_after_create": {
          "type": "boolean"
        },
        "real_data": {
          "additionalProperties": false,
          "properties": {
            "cache_raw": {
              "type": "boolean"
            },
            "cdl_render_mode": {
              "enum": [
                "auto",
                "service_png",
                "manual_samples",
                "service_tiff"
              ],
              "type": "string"
            },
            "cdl_verify_samples": {
              "type": "boolean"
            },
            "debug_artifacts": {
              "type": "boolean"
            },
            "enabled": {
              "type": "boolean"
            },
            "include_archives": {
              "type": "boolean"
            },
            "max_bytes_per_source": {
              "minimum": 1,
              "type": "integer"
            },
            "max_pixels": {
              "minimum": 1,
              "type": "integer"
            },
            "preview_expand_factor": {
              "maximum": 25.0,
              "minimum": 1.0,
              "type": "number"
            },
            "preview_size": {
              "minimum": 1,
              "type": "integer"
            },
            "sample_grid_size": {
              "maximum": 7,
              "minimum": 1,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "style": {
          "type": "string"
        }
      },
      "required": [
        "color_scheme",
        "open_after_create"
      ],
      "type": "object"
    },
    "sources": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "target_grid": {
      "additionalProperties": false,
      "properties": {
        "crs": {
          "minLength": 1,
          "type": "string"
        },
        "resolution_m": {
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "crs"
      ],
      "type": "object"
    },
    "task_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "type": "string"
    },
    "themes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "time": {
      "additionalProperties": false,
      "properties": {
        "dates": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "years": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "years",
        "dates"
      ],
      "type": "object"
    }
  },
  "required": [
    "task_id",
    "name",
    "aoi",
    "target_grid",
    "time",
    "themes",
    "sources",
    "preview",
    "notes"
  ],
  "title": "FasterRaster Data Task",
  "type": "object"
}
