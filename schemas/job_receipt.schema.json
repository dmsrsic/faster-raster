    "dependency_statuses": {
      "type": "object"
    },
    "input_contract_sha256": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "network_attempted": {
      "type": "boolean"
    },
    "output_contract_sha256": {
      "type": "string"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "stage": {
      "type": "string"
