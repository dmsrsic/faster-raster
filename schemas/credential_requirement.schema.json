{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_hosts": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "asset_hosts": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "authentication_scheme": {
      "enum": [
        "bearer",
        "api_key",
        "oauth2"
      ]
    },
    "credential_ref": {
      "type": "string"
    },
    "credential_requirement_sha256": {
      "type": "string"
    },
    "redirect_hosts": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "resolved_secret_present": {
      "const": false
    },
    "resolver_capability_required": {
      "type": "string"
    },
    "schema_version": {
      "const": "fasterraster.credential-requirement/v1"
    }
  },
  "required": [
    "schema_version",
    "authentication_scheme",
    "credential_ref",
    "allowed_hosts",
    "redirect_hosts",
    "asset_hosts",
    "resolver_capability_required",
    "resolved_secret_present",
    "credential_requirement_sha256"
  ],
  "title": "FasterRaster public credential requirement v1",
  "type": "object"
}
