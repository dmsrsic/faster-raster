{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "credential_requirement_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "credential_scheme": {
      "enum": [
        "aws_sigv4",
        "ephemeral_https_signer",
        "google_adc",
        "oauth2_bearer",
        "s3_compatible"
      ]
    },
    "exact_hosts": {
      "type": "object"
    },
    "host_suffixes": {
      "type": "object"
    },
    "operations": {
      "items": {
        "enum": [
          "catalogue",
          "resolver",
          "asset",
          "compute"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "resolved_secret_present": {
      "const": false
    },
    "resolver_capability_required": {
      "type": "string"
    },
    "schema_version": {
      "const": "fasterraster.credential-requirement/v2"
    }
  },
  "required": [
    "schema_version",
    "credential_scheme",
    "operations",
    "exact_hosts",
    "host_suffixes",
    "resolver_capability_required",
    "resolved_secret_present",
    "credential_requirement_sha256"
  ],
  "title": "FasterRaster public credential requirement v2",
  "type": "object"
}
