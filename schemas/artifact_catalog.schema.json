{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "artifact_count": {
      "type": "integer"
    },
    "catalog_contract_sha256": {
      "type": "string"
    },
    "catalog_version": {
      "type": "integer"
    },
    "entries": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "total_materialized_bytes": {
      "type": "integer"
    }
  },
  "required": [
    "catalog_version",
    "artifact_count",
    "total_materialized_bytes",
    "entries",
    "catalog_contract_sha256"
  ],
  "title": "FasterRaster v0.9 artifact catalog",
  "type": "object"
}
