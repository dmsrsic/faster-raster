{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dmsrsic.github.io/faster-raster/schemas/fasterraster-update-check-receipt-v1.schema.json",
  "title": "FasterRaster update check receipt v1",
  "description": "The canonical stored receipt omits receipt_sha256 and is hashed byte-for-byte. Presentation JSON may add receipt_sha256 as external metadata; that field is never part of its own hash domain.",
  "type": "object",
  "required": ["schema_version", "status", "channel", "installation", "candidate", "recommendation", "error"],
  "properties": {
    "schema_version": {"const": "fasterraster.update-check-receipt/v1"},
    "status": {"enum": ["offline", "blocked", "checked", "error"]},
    "channel": {"enum": ["stable", "beta"]},
    "installation": {
      "type": "object",
      "required": ["active_version", "python_version", "git_context", "distribution_origin", "compatible"],
      "properties": {
        "active_version": {"type": "string"},
        "python_version": {"type": "string"},
        "git_context": {"enum": ["absent", "clean_checkout", "dirty_checkout"]},
        "distribution_origin": {"enum": ["editable", "local_wheel", "local_sdist", "package_index_or_unknown", "ambiguous"]},
        "compatible": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": ["object", "null"],
      "properties": {
        "schema_version": {"const": "fasterraster.release-manifest/v1"},
        "tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-(?:alpha|beta|rc)\\.[0-9]+)?$"},
        "package_version": {"type": "string"},
        "channel": {"enum": ["stable", "beta"]},
        "requires_python": {"type": "string"},
        "updater_manifest_major": {"const": 1},
        "release_notes_url": {"type": "string", "format": "uri", "pattern": "^https://github.com/dmsrsic/faster-raster/releases/tag/"},
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kind", "name", "url", "sha256", "size_bytes"],
            "properties": {
              "kind": {"enum": ["wheel", "sdist", "checksums", "manifest"]},
              "name": {"type": "string", "minLength": 1},
              "url": {"type": "string", "format": "uri", "pattern": "^https://"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "size_bytes": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "required": ["schema_version", "tag", "package_version", "channel", "requires_python", "updater_manifest_major", "release_notes_url", "assets"],
      "additionalProperties": false
    },
    "recommendation": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {"enum": ["blocked", "none", "manual_git_fast_forward", "manual_editable_reinstall", "manual_wheel_install", "unsupported"]},
        "reason": {"type": "string"},
        "argv": {"type": "array", "items": {"type": "string"}},
        "guidance": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "error": {"type": ["string", "null"]},
    "receipt_sha256": {"description": "Optional presentation-only digest of the canonical stored receipt bytes.", "type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
