        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "minimum_support_pixels": {
          "default": 1,
          "maximum": 100000000,
          "minimum": 1,
          "title": "Minimum Support Pixels",
          "type": "integer"
        },
        "output_code": {
          "maximum": 254,
          "minimum": 7,
          "title": "Output Code",
          "type": "integer"
        },
        "priority": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "strategy": {
          "discriminator": {
            "mapping": {
              "multi_index_boolean": "#/$defs/MultiIndexBooleanStrategy",
              "multi_index_weighted_score": "#/$defs/MultiIndexWeightedStrategy",
              "single_index_threshold": "#/$defs/SingleIndexThresholdStrategy",
              "target_signature_similarity": "#/$defs/TargetSignatureStrategy"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/SingleIndexThresholdStrategy"
            },
            {
              "$ref": "#/$defs/MultiIndexBooleanStrategy"
            },
            {
              "$ref": "#/$defs/MultiIndexWeightedStrategy"
            },
            {
              "$ref": "#/$defs/TargetSignatureStrategy"
            }
          ],
          "title": "Strategy"
        },
        "uncertainty_behavior": {
          "enum": [
            "keep_general",
            "mark_unresolved"
          ],
          "title": "Uncertainty Behavior",
          "type": "string"
        },
        "unsupported_interpretations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Unsupported Interpretations",
          "type": "array"
        }
      },
      "required": [
        "class_id",
        "label",
        "output_code",
        "intended_interpretation",
        "unsupported_interpretations",
        "strategy",
        "eligible_parent_general_classes",
        "priority",
        "uncertainty_behavior",
        "calibration"
      ],
      "title": "SpecialistClassSpec",
      "type": "object"
    },
    "SpecialistCollectionSpec": {
      "additionalProperties": false,
      "properties": {
        "automatic_authorized": {
          "default": false,
          "title": "Automatic Authorized",
          "type": "boolean"
        },
        "classes": {
          "items": {
            "$ref": "#/$defs/SpecialistClassSpec"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Classes",
          "type": "array"
        },
        "requested_class_count": {
          "maximum": 32,
          "minimum": 1,
          "title": "Requested Class Count",
          "type": "integer"
        },
        "search": {
          "$ref": "#/$defs/CandidateSearchBoundsSpec"
        },
        "selection_mode": {
          "enum": [
            "user_defined",
            "recommendation",
            "automatic"
          ],
          "title": "Selection Mode",
          "type": "string"
        }
      },
      "required": [
        "requested_class_count",
        "selection_mode",
        "classes"
      ],
      "title": "SpecialistCollectionSpec",
      "type": "object"
    },
    "TargetSignatureStrategy": {
      "additionalProperties": false,
      "properties": {
        "target_bands": {
          "additionalProperties": {
            "type": "number"
          },
          "maxProperties": 7,
          "minProperties": 2,
          "title": "Target Bands",
          "type": "object"
        },
        "target_source": {
          "enum": [
            "user_provided",
            "positive_calibration_points"
          ],
          "title": "Target Source",
          "type": "string"
        },
        "threshold": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Threshold",
          "type": "number"
        },
        "type": {
          "const": "target_signature_similarity",
          "title": "Type",
          "type": "string"
        },
        "weights": {
          "additionalProperties": {
            "type": "number"
          },
          "maxProperties": 7,
          "title": "Weights",
          "type": "object"
        }
      },
      "required": [
        "type",
        "target_bands",
        "threshold",
        "target_source"
      ],
      "title": "TargetSignatureStrategy",
      "type": "object"
    },
    "TimeSpec": {
      "additionalProperties": false,
      "properties": {
        "crop_year": {
          "maximum": 2200,
          "minimum": 1900,
          "title": "Crop Year",
          "type": "integer"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "crop_year"
      ],
      "title": "TimeSpec",
      "type": "object"
    },
    "WeightedIndexInputSpec": {
      "additionalProperties": false,
      "properties": {
        "index_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Index Id",
          "type": "string"
        },
        "normalization_maximum": {
          "title": "Normalization Maximum",
          "type": "number"
        },
        "normalization_minimum": {
          "title": "Normalization Minimum",
          "type": "number"
        },
        "weight": {
          "maximum": 1000.0,
          "minimum": -1000.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "index_id",
        "normalization_minimum",
        "normalization_maximum",
        "weight"
      ],
      "title": "WeightedIndexInputSpec",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "area": {
      "$ref": "#/$defs/AreaSpec"
    },
    "classification": {
      "anyOf": [
        {
          "$ref": "#/$defs/HybridClassificationSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "correlation": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnvironmentalCorrelationSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "data": {
      "$ref": "#/$defs/DataSpec"
    },
    "limits": {
      "$ref": "#/$defs/LimitsSpec"
    },
    "name": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Name",
      "type": "string"
    },
    "outputs": {
      "$ref": "#/$defs/OutputSpec"
    },
    "processing": {
      "$ref": "#/$defs/ProcessingSpec"
    },
    "recipe": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recipe"
    },
    "schema_version": {
      "const": "fasterraster.work/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "$ref": "#/$defs/SourcesSpec"
    },
    "time": {
      "$ref": "#/$defs/TimeSpec"
    },
    "workflow": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workflow"
    }
  },
  "required": [
    "schema_version",
    "name",
    "area",
    "time"
  ],
  "title": "FasterRaster Markdown workfile v1 front matter",
  "type": "object"
}
