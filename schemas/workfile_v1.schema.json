    "SpecialistClassSpec": {
      "additionalProperties": false,
      "properties": {
        "calibration": {
          "$ref": "#/$defs/CalibrationEvidenceSpec"
        },
        "class_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Class Id",
          "type": "string"
        },
        "eligible_parent_general_classes": {
          "items": {
            "enum": [
              "cropland",
              "fallow_or_barren",
              "developed_open_or_low",
              "developed_medium_or_high",
              "noncrop_vegetation",
              "water"
