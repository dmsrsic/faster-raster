{
  "$defs": {
    "CalibrationEvidenceSpec": {
      "additionalProperties": false,
      "properties": {
        "minimum_negative_support": {
          "default": 20,
          "maximum": 100000,
          "minimum": 1,
          "title": "Minimum Negative Support",
          "type": "integer"
        },
        "minimum_positive_support": {
          "default": 20,
          "maximum": 100000,
          "minimum": 1,
          "title": "Minimum Positive Support",
          "type": "integer"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/CalibrationPointSpec"
          },
          "maxItems": 5000,
          "title": "Points",
          "type": "array"
        },
        "positive_general_classes": {
          "items": {
            "enum": [
              "cropland",
              "fallow_or_barren",
              "developed_open_or_low",
              "developed_medium_or_high",
              "noncrop_vegetation",
              "water"
            ],
            "type": "string"
          },
          "maxItems": 6,
          "title": "Positive General Classes",
          "type": "array"
        },
        "publish_coordinates": {
          "const": false,
          "default": false,
          "title": "Publish Coordinates",
          "type": "boolean"
        },
        "source": {
          "enum": [
            "fixed_rule",
            "cdl_weak_labels",
            "user_points",
            "target_vector"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "CalibrationEvidenceSpec",
      "type": "object"
    },
    "CalibrationPointSpec": {
      "additionalProperties": false,
      "properties": {
        "class_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Class Id",
          "type": "string"
        },
        "latitude": {
          "maximum": 90.0,
          "minimum": -90.0,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180.0,
          "minimum": -180.0,
          "title": "Longitude",
          "type": "number"
        }
      },
      "required": [
        "longitude",
        "latitude",
        "class_id"
      ],
      "title": "CalibrationPointSpec",
      "type": "object"
    },
    "CandidateSearchBoundsSpec": {
      "additionalProperties": false,
      "properties": {
        "candidate_indices": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Candidate Indices",
          "type": "array"
        },
        "inner_spatial_folds": {
          "default": 3,
          "maximum": 10,
          "minimum": 2,
          "title": "Inner Spatial Folds",
          "type": "integer"
        },
        "maximum_calibration_samples": {
          "default": 100000,
          "maximum": 1000000,
          "minimum": 40,
          "title": "Maximum Calibration Samples",
          "type": "integer"
        },
        "maximum_candidate_models": {
          "default": 128,
          "maximum": 512,
          "minimum": 1,
          "title": "Maximum Candidate Models",
          "type": "integer"
        },
        "maximum_pairs": {
          "default": 36,
          "maximum": 66,
          "minimum": 0,
          "title": "Maximum Pairs",
          "type": "integer"
        },
        "maximum_triples": {
          "default": 24,
          "maximum": 220,
          "minimum": 0,
          "title": "Maximum Triples",
          "type": "integer"
        },
        "minimum_complexity_improvement": {
          "default": 0.01,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Minimum Complexity Improvement",
          "type": "number"
        },
        "minimum_selection_metric": {
          "default": 0.55,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Minimum Selection Metric",
          "type": "number"
        },
        "ranking_metric": {
          "default": "macro_f1",
          "enum": [
            "macro_f1",
            "balanced_accuracy"
          ],
          "title": "Ranking Metric",
          "type": "string"
        },
        "tie_tolerance": {
          "default": 1e-09,
          "maximum": 0.01,
          "minimum": 0.0,
          "title": "Tie Tolerance",
          "type": "number"
        }
      },
      "title": "CandidateSearchBoundsSpec",
      "type": "object"
    },
    "GeneralClassificationSpec": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "const": "random_forest",
          "title": "Backend",
          "type": "string"
        },
        "class_ids": {
          "items": {
            "enum": [
              "cropland",
              "fallow_or_barren",
              "developed_open_or_low",
              "developed_medium_or_high",
              "noncrop_vegetation",
              "water"
            ],
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Class Ids",
          "type": "array"
        },
        "class_weight": {
          "const": "balanced_subsample",
          "default": "balanced_subsample",
          "title": "Class Weight",
          "type": "string"
        },
        "confidence_threshold": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence Threshold",
          "type": "number"
        },
        "features": {
          "items": {
            "enum": [
              "red",
              "green",
              "blue",
              "nir",
              "ndvi",
              "gndvi",
              "vari",
              "excess_green",
              "brightness",
              "saturation"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Features",
          "type": "array"
        },
        "inference_window_size": {
          "maximum": 4096,
          "minimum": 16,
          "title": "Inference Window Size",
          "type": "integer"
        },
        "mapping_id": {
          "const": "cdl_surface_superclasses_v1",
          "title": "Mapping Id",
          "type": "string"
        },
        "max_depth": {
          "default": 20,
          "maximum": 256,
          "minimum": 1,
          "title": "Max Depth",
          "type": "integer"
        },
        "max_features": {
          "const": "sqrt",
          "default": "sqrt",
          "title": "Max Features",
          "type": "string"
        },
        "maximum_samples_per_class": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Maximum Samples Per Class",
          "type": "integer"
        },
        "min_samples_leaf": {
          "default": 5,
          "maximum": 100000,
          "minimum": 1,
          "title": "Min Samples Leaf",
          "type": "integer"
        },
        "minimum_training_samples_per_class": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Minimum Training Samples Per Class",
          "type": "integer"
        },
        "n_estimators": {
          "default": 192,
          "maximum": 4096,
          "minimum": 1,
          "title": "N Estimators",
          "type": "integer"
        },
        "n_jobs": {
          "const": 1,
          "default": 1,
          "title": "N Jobs",
          "type": "integer"
        },
        "random_seed": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Random Seed",
          "type": "integer"
        },
        "requested_class_count": {
          "maximum": 6,
          "minimum": 1,
          "title": "Requested Class Count",
          "type": "integer"
        },
        "sieve_minimum_pixels": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Sieve Minimum Pixels",
          "type": "integer"
        },
        "spatial_holdout_fold": {
          "default": 0,
          "maximum": 19,
          "minimum": 0,
          "title": "Spatial Holdout Fold",
          "type": "integer"
        },
        "spatial_holdout_folds": {
          "maximum": 20,
          "minimum": 2,
          "title": "Spatial Holdout Folds",
          "type": "integer"
        },
        "training_core_radius_cdl_cells": {
          "maximum": 8,
          "minimum": 1,
          "title": "Training Core Radius Cdl Cells",
          "type": "integer"
        }
      },
      "required": [
        "mapping_id",
        "backend",
        "random_seed",
        "training_core_radius_cdl_cells",
        "maximum_samples_per_class",
        "minimum_training_samples_per_class",
        "spatial_holdout_folds",
        "inference_window_size",
        "confidence_threshold",
        "sieve_minimum_pixels",
        "features",
        "requested_class_count",
        "class_ids"
      ],
      "title": "GeneralClassificationSpec",
      "type": "object"
    },
    "HybridArbitrationSpec": {
      "additionalProperties": false,
      "properties": {
        "compare_unscaled_scores": {
          "const": false,
          "default": false,
          "title": "Compare Unscaled Scores",
          "type": "boolean"
        },
        "equal_priority_tie": {
          "enum": [
            "mark_unresolved",
            "lowest_class_code"
          ],
          "title": "Equal Priority Tie",
          "type": "string"
        },
        "policy": {
          "const": "priority_then_class_code",
          "title": "Policy",
          "type": "string"
        },
        "preserve_general_output": {
          "const": true,
          "default": true,
          "title": "Preserve General Output",
          "type": "boolean"
        },
        "unresolved_code": {
          "const": 255,
          "default": 255,
          "title": "Unresolved Code",
          "type": "integer"
        }
      },
      "required": [
        "policy",
        "equal_priority_tie"
      ],
      "title": "HybridArbitrationSpec",
      "type": "object"
    },
    "HybridClassificationSpec": {
      "additionalProperties": false,
      "properties": {
        "arbitration": {
          "$ref": "#/$defs/HybridArbitrationSpec"
        },
        "general": {
          "$ref": "#/$defs/GeneralClassificationSpec"
        },
        "indices": {
          "items": {
            "$ref": "#/$defs/IndexRequestSpec"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Indices",
          "type": "array"
        },
        "specialists": {
          "$ref": "#/$defs/SpecialistCollectionSpec"
        }
      },
      "required": [
        "general",
        "indices",
        "specialists",
        "arbitration"
      ],
      "title": "HybridClassificationSpec",
      "type": "object"
    },
    "IndexConditionSpec": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "high",
            "low",
            "range"
          ],
          "title": "Direction",
          "type": "string"
        },
        "index_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Index Id",
          "type": "string"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        }
      },
      "required": [
        "index_id",
        "direction"
      ],
      "title": "IndexConditionSpec",
      "type": "object"
    },
    "IndexRequestSpec": {
      "additionalProperties": false,
      "properties": {
        "display": {
          "default": false,
          "title": "Display",
          "type": "boolean"
        },
        "expression": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expression"
        },
        "index_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Index Id",
          "type": "string"
        },
        "persist": {
          "default": false,
          "title": "Persist",
          "type": "boolean"
        }
      },
      "required": [
        "index_id"
      ],
      "title": "IndexRequestSpec",
      "type": "object"
    },
    "MultiIndexBooleanStrategy": {
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "items": {
            "$ref": "#/$defs/IndexConditionSpec"
          },
          "maxItems": 12,
          "minItems": 2,
          "title": "Conditions",
          "type": "array"
        },
        "k": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "K"
        },
        "operator": {
          "enum": [
            "all",
            "any",
            "at_least_k"
          ],
          "title": "Operator",
          "type": "string"
        },
        "type": {
          "const": "multi_index_boolean",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "operator",
        "conditions"
      ],
      "title": "MultiIndexBooleanStrategy",
      "type": "object"
    },
    "MultiIndexWeightedStrategy": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "default": "high",
          "enum": [
            "high",
            "low"
          ],
          "title": "Direction",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/WeightedIndexInputSpec"
          },
          "maxItems": 12,
          "minItems": 2,
          "title": "Inputs",
          "type": "array"
        },
        "intercept": {
          "default": 0.0,
          "maximum": 1000.0,
          "minimum": -1000.0,
          "title": "Intercept",
          "type": "number"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        },
        "type": {
          "const": "multi_index_weighted_score",
          "title": "Type",
          "type": "string"
        },
        "weights_source": {
          "enum": [
            "user_provided",
            "learned_spatial_calibration"
          ],
          "title": "Weights Source",
          "type": "string"
        }
      },
      "required": [
        "type",
        "inputs",
        "threshold",
        "weights_source"
      ],
      "title": "MultiIndexWeightedStrategy",
      "type": "object"
    },
    "RecipeDefaults": {
      "additionalProperties": false,
      "properties": {
        "max_total_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 20000000000,
          "title": "Max Total Bytes",
          "type": "integer"
        },
        "naip_resolution_meters": {
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Naip Resolution Meters",
          "type": "number"
        },
        "portion": {
          "enum": [
            "native",
            "overview"
          ],
          "title": "Portion",
          "type": "string"
        },
        "preview_width": {
          "maximum": 16384,
          "minimum": 640,
          "title": "Preview Width",
          "type": "integer"
        },
        "service_tile_size": {
          "maximum": 10000,
          "minimum": 64,
          "title": "Service Tile Size",
          "type": "integer"
        }
      },
      "required": [
        "max_total_bytes",
        "naip_resolution_meters",
        "portion",
        "preview_width",
        "service_tile_size"
      ],
      "title": "RecipeDefaults",
      "type": "object"
    },
    "RecipeResampling": {
      "additionalProperties": false,
      "properties": {
        "categorical": {
          "enum": [
            "nearest",
            "mode",
            "bilinear",
            "cubic",
            "lanczos",
            "average"
          ],
          "title": "Categorical",
          "type": "string"
        },
        "imagery": {
          "enum": [
            "nearest",
            "mode",
            "bilinear",
            "cubic",
            "lanczos",
            "average"
          ],
          "title": "Imagery",
          "type": "string"
        },
        "terrain": {
          "anyOf": [
            {
              "enum": [
                "nearest",
                "mode",
                "bilinear",
                "cubic",
                "lanczos",
                "average"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terrain"
        }
      },
      "required": [
        "categorical",
        "imagery"
      ],
      "title": "RecipeResampling",
      "type": "object"
    },
    "SingleIndexThresholdStrategy": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "$ref": "#/$defs/IndexConditionSpec"
        },
        "type": {
          "const": "single_index_threshold",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "condition"
      ],
      "title": "SingleIndexThresholdStrategy",
      "type": "object"
    },
    "SpecialistClassSpec": {
      "additionalProperties": false,
      "properties": {
        "calibration": {
          "$ref": "#/$defs/CalibrationEvidenceSpec"
        },
        "class_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Class Id",
          "type": "string"
        },
        "eligible_parent_general_classes": {
          "items": {
            "enum": [
              "cropland",
              "fallow_or_barren",
              "developed_open_or_low",
              "developed_medium_or_high",
              "noncrop_vegetation",
              "water"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Eligible Parent General Classes",
          "type": "array"
        },
        "intended_interpretation": {
          "minLength": 1,
          "title": "Intended Interpretation",
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "minimum_support_pixels": {
          "default": 1,
          "maximum": 100000000,
          "minimum": 1,
          "title": "Minimum Support Pixels",
          "type": "integer"
        },
        "output_code": {
          "maximum": 254,
          "minimum": 7,
          "title": "Output Code",
          "type": "integer"
        },
        "priority": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "strategy": {
          "discriminator": {
            "mapping": {
              "multi_index_boolean": "#/$defs/MultiIndexBooleanStrategy",
              "multi_index_weighted_score": "#/$defs/MultiIndexWeightedStrategy",
              "single_index_threshold": "#/$defs/SingleIndexThresholdStrategy",
              "target_signature_similarity": "#/$defs/TargetSignatureStrategy"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/SingleIndexThresholdStrategy"
            },
            {
              "$ref": "#/$defs/MultiIndexBooleanStrategy"
            },
            {
              "$ref": "#/$defs/MultiIndexWeightedStrategy"
            },
            {
              "$ref": "#/$defs/TargetSignatureStrategy"
            }
          ],
          "title": "Strategy"
        },
        "uncertainty_behavior": {
          "enum": [
            "keep_general",
            "mark_unresolved"
          ],
          "title": "Uncertainty Behavior",
          "type": "string"
        },
        "unsupported_interpretations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Unsupported Interpretations",
          "type": "array"
        }
      },
      "required": [
        "class_id",
        "label",
        "output_code",
        "intended_interpretation",
        "unsupported_interpretations",
        "strategy",
        "eligible_parent_general_classes",
        "priority",
        "uncertainty_behavior",
        "calibration"
      ],
      "title": "SpecialistClassSpec",
      "type": "object"
    },
    "SpecialistCollectionSpec": {
      "additionalProperties": false,
      "properties": {
        "automatic_authorized": {
          "default": false,
          "title": "Automatic Authorized",
          "type": "boolean"
        },
        "classes": {
          "items": {
            "$ref": "#/$defs/SpecialistClassSpec"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Classes",
          "type": "array"
        },
        "requested_class_count": {
          "maximum": 32,
          "minimum": 1,
          "title": "Requested Class Count",
          "type": "integer"
        },
        "search": {
          "$ref": "#/$defs/CandidateSearchBoundsSpec"
        },
        "selection_mode": {
          "enum": [
            "user_defined",
            "recommendation",
            "automatic"
          ],
          "title": "Selection Mode",
          "type": "string"
        }
      },
      "required": [
        "requested_class_count",
        "selection_mode",
        "classes"
      ],
      "title": "SpecialistCollectionSpec",
      "type": "object"
    },
    "TargetSignatureStrategy": {
      "additionalProperties": false,
      "properties": {
        "target_bands": {
          "additionalProperties": {
            "type": "number"
          },
          "maxProperties": 7,
          "minProperties": 2,
          "title": "Target Bands",
          "type": "object"
        },
        "target_source": {
          "enum": [
            "user_provided",
            "positive_calibration_points"
          ],
          "title": "Target Source",
          "type": "string"
        },
        "threshold": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Threshold",
          "type": "number"
        },
        "type": {
          "const": "target_signature_similarity",
          "title": "Type",
          "type": "string"
        },
        "weights": {
          "additionalProperties": {
            "type": "number"
          },
          "maxProperties": 7,
          "title": "Weights",
          "type": "object"
        }
      },
      "required": [
        "type",
        "target_bands",
        "threshold",
        "target_source"
      ],
      "title": "TargetSignatureStrategy",
      "type": "object"
    },
    "WeightedIndexInputSpec": {
      "additionalProperties": false,
      "properties": {
        "index_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Index Id",
          "type": "string"
        },
        "normalization_maximum": {
          "title": "Normalization Maximum",
          "type": "number"
        },
        "normalization_minimum": {
          "title": "Normalization Minimum",
          "type": "number"
        },
        "weight": {
          "maximum": 1000.0,
          "minimum": -1000.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "index_id",
        "normalization_minimum",
        "normalization_maximum",
        "weight"
      ],
      "title": "WeightedIndexInputSpec",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis_type": {
      "const": "index_guided_hybrid_classification",
      "title": "Analysis Type",
      "type": "string"
    },
    "classification": {
      "$ref": "#/$defs/HybridClassificationSpec"
    },
    "defaults": {
      "$ref": "#/$defs/RecipeDefaults"
    },
    "inspection_focus": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Inspection Focus",
      "type": "array"
    },
    "maximum_naip_pixel_size_m": {
