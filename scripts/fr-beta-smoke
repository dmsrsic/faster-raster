#!/usr/bin/env sh
set -eu

usage() {
    echo "usage: ./scripts/fr-beta-smoke --quick|--full" >&2
}

if [ "$#" -ne 1 ]; then
    usage
    exit 2
fi
mode=$1
case "$mode" in
    --quick|--full) ;;
    *) usage; exit 2 ;;
esac

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH= cd -- "$script_dir/.." && pwd)

if [ -n "${FASTERRASTER_PYTHON:-}" ]; then
    python_runtime=$FASTERRASTER_PYTHON
elif [ -x "$repository_root/.beta-tools/recipe-env/bin/python" ]; then
    python_runtime="$repository_root/.beta-tools/recipe-env/bin/python"
elif [ -x "$repository_root/.beta-tools/human-development-live-env/bin/python" ]; then
    python_runtime="$repository_root/.beta-tools/human-development-live-env/bin/python"
elif command -v python3.12 >/dev/null 2>&1; then
    python_runtime=$(command -v python3.12)
else
    echo "ERROR: Python 3.12 and FasterRaster dependencies are required." >&2
    exit 2
fi


runtime_bin=$(dirname -- "$python_runtime")
if [ -x "$runtime_bin/faster-raster" ]; then
    faster_raster_cli="$runtime_bin/faster-raster"
elif command -v faster-raster >/dev/null 2>&1; then
    faster_raster_cli=$(command -v faster-raster)
else
    echo "ERROR: installed faster-raster console command is required." >&2
    exit 2
fi
temporary_root=$(mktemp -d "${TMPDIR:-/tmp}/fasterraster-beta-smoke.XXXXXX")
trap 'rm -rf -- "$temporary_root"' EXIT HUP INT TERM

export XDG_CONFIG_HOME="$temporary_root/xdg-config"
export XDG_CACHE_HOME="$temporary_root/xdg-cache"
export XDG_STATE_HOME="$temporary_root/xdg-state"
export PYTHONDONTWRITEBYTECODE=1

cd "$repository_root"
index_count_before=$(git diff --cached --name-only | wc -l | tr -d ' ')
index_hash_before=$(git diff --cached --binary | sha256sum | awk '{print $1}')

echo "[smoke] installed CLI and offline doctor"
if command -v fr >/dev/null 2>&1; then
    fr --help >/dev/null
else
    "$python_runtime" -m faster_raster.fr_cli --help >/dev/null
fi
"$python_runtime" -m faster_raster.fr_cli doctor --offline >/dev/null
"$python_runtime" -m faster_raster.fr_cli templates list >/dev/null

echo "[smoke] deterministic template generation and offline validation"
for template_id in human-development-cdl human-development-cdl-reuse ag-cdl-naip generic-cog; do
    workfile="$temporary_root/$template_id.fr.md"
    case "$template_id" in
        human-development-*) set -- 2008 2016 2021 ;;
        *) set -- 2021 ;;
    esac
    "$python_runtime" -m faster_raster.fr_cli init "$workfile" \
        --template "$template_id" \
        --name "smoke-$template_id" \
        --bbox -116.45 43.58 -116.35 43.68 \
        --years "$@" >/dev/null
    "$python_runtime" -m faster_raster.fr_cli validate "$workfile" >/dev/null
done

echo "[smoke] schema determinism and source registry"
"$python_runtime" -c 'from pathlib import Path; from faster_raster.schema_export import export_schemas; import sys; export_schemas(Path(sys.argv[1]))' "$temporary_root/schema-a"
"$python_runtime" -c 'from pathlib import Path; from faster_raster.schema_export import export_schemas; import sys; export_schemas(Path(sys.argv[1]))' "$temporary_root/schema-b"
diff -qr "$temporary_root/schema-a" "$temporary_root/schema-b" >/dev/null
"$python_runtime" -c 'from faster_raster.source_registry import load_registry; assert load_registry().sources'

echo "[smoke] focused offline regressions"
"$python_runtime" -m pytest -q \
    tests/test_beta_closeout.py \
    tests/test_human_development_analysis.py \
    tests/test_human_development_workflow.py \
    tests/test_human_development_cdl_bridge.py

known_handoff=
if [ -d outputs/handoffs ]; then
    for candidate in outputs/handoffs/*; do
        if [ -f "$candidate/checksums.sha256" ] && [ -f "$candidate/manifest.json" ]; then
            known_handoff=$candidate
        fi
    done
fi
if [ -n "$known_handoff" ]; then
    echo "[smoke] verify finalized local proof: $known_handoff"
    (cd "$known_handoff" && sha256sum -c checksums.sha256 >/dev/null)
else
    echo "[smoke] no finalized local proof available; checksum check skipped"
fi

if [ "$mode" = "--full" ]; then
    echo "[smoke] complete pytest suite"
    "$python_runtime" -m pytest -q
    echo "[smoke] beta check"
    FASTERRASTER_PYTHON="$python_runtime" "$script_dir/fr-beta-check" --output "$temporary_root/beta-check"
    echo "[smoke] system grader"
    FASTERRASTER_REPORT_ROOT="$temporary_root/reports" \
        FASTERRASTER_RUN_ROOT="$temporary_root/reports/runs" \
        FASTERRASTER_MATERIALIZATION_ROOT="$temporary_root/reports/materializations" \
        "$faster_raster_cli" grade system --plain
fi

index_count_after=$(git diff --cached --name-only | wc -l | tr -d ' ')
index_hash_after=$(git diff --cached --binary | sha256sum | awk '{print $1}')
if [ "$index_count_before" != "$index_count_after" ] || [ "$index_hash_before" != "$index_hash_after" ]; then
    echo "ERROR: smoke test mutated the Git index." >&2
    exit 1
fi

echo "FasterRaster beta smoke PASS ($mode; offline unless an invoked full gate uses verified local evidence)"
