def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Cook an agricultural FasterRaster handoff tray."
    )
    parser.add_argument("--name", required=True)
    parser.add_argument(
        "--recipe",
        help="Agricultural recipe ID; enables asset-level recipe execution.",
    )
    parser.add_argument(
        "--reuse",
        choices=["auto", "only", "never"],
        default="auto",
        help="Recipe cache policy (default: auto).",
    )
    parser.add_argument("--bbox", required=True)
    parser.add_argument("--start", required=True)
    parser.add_argument("--end", required=True)
    parser.add_argument("--cdl-year", required=True, type=int)
    parser.add_argument(
        "--portion",
        choices=["native", "overview"],
        default="native",
    )
    parser.add_argument(
        "--max-total-bytes",
        type=int,
        default=2_000_000_000,
    )
    parser.add_argument(
        "--preview-width",
        type=int,
        default=3840,
    )
    parser.add_argument(
        "--naip-resolution",
        type=float,
        default=None,
        help="Output NAIP resolution in meters; omit for catalog-native.",
    )
    parser.add_argument(
        "--service-tile-size",
        type=int,
        default=1800,
        help="Maximum width and height of each service export request.",
    )
    parser.add_argument("--open", action="store_true")
    parser.add_argument(
        "--asset-only",
        action="store_true",
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "--preflight-only",
        action="store_true",
        help="run bounded source coverage checks without raster transfer",
    )

    parser.add_argument(
        "--assets",
        default=None,
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "--output-dir",
        type=Path,
        default=None,
        help=argparse.SUPPRESS,
    )
    return parser.parse_args()


ARGS = parse_args()

try:
    WEST, SOUTH, EAST, NORTH = validate_bbox_text(ARGS.bbox)
except BBoxValidationError as error:
    raise SystemExit(f"Invalid agricultural bbox: {error}") from error

try:
    START = datetime.fromisoformat(ARGS.start).replace(tzinfo=timezone.utc)
    END = datetime.fromisoformat(ARGS.end).replace(tzinfo=timezone.utc)
except ValueError as error:
    raise SystemExit(
        "The agricultural timeframe must use valid ISO-8601 dates."
    ) from error

if START >= END:
    raise SystemExit("The timeframe start must precede its end.")

if START.year != ARGS.cdl_year or END.year != ARGS.cdl_year:
    raise SystemExit("The growing-season dates must match --cdl-year.")

try:
    if not 0 < ARGS.max_total_bytes <= 20_000_000_000:
        raise BBoxValidationError(
            "--max-total-bytes must be between 1 and 20,000,000,000"
        )
    if not 64 <= ARGS.service_tile_size <= 10_000:
        raise BBoxValidationError(
            "--service-tile-size must be between 64 and 10,000"
        )
    if not 320 <= ARGS.preview_width <= 16_384:
        raise BBoxValidationError(
            "--preview-width must be between 320 and 16,384"
        )
    REQUESTED_ASSETS = parse_requested_assets(
        ARGS.asset_only,
        ARGS.assets,
    )
    AOI_SAFETY = validate_aoi_safety(
        (WEST, SOUTH, EAST, NORTH),
        maximum_network_bytes=ARGS.max_total_bytes,
        asset_resolutions=asset_safety_profile(
            REQUESTED_ASSETS,
            ARGS.naip_resolution,
        ),
    )
except BBoxValidationError as error:
    raise SystemExit(f"Unsafe agricultural request: {error}") from error

for executable in (
    "gdalinfo",
    "gdal_translate",
    "gdalbuildvrt",
    "gdalwarp",
):
    if shutil.which(executable) is None:
        raise SystemExit(f"Missing required executable: {executable}")

STAMP = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
