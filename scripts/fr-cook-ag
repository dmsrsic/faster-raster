                "where": "1=1",
                "geometry": {
                    "xmin": WEST,
                    "ymin": SOUTH,
                    "xmax": EAST,
                    "ymax": NORTH,
                    "spatialReference": {"wkid": 4326},
                },
                "geometryType": "esriGeometryEnvelope",
                "inSR": "4326",
                "spatialRel": "esriSpatialRelIntersects",
                "outFields": "Year",
                "returnGeometry": "false",
                "resultRecordCount": "50",
            },
                label="naip_available_years_query",
                source="USGS_NAIP",
            )
        )

    naip_validation = require_source_coverage(
        lambda: validate_naip_catalog(
            naip_catalog,
            requested_year=ARGS.cdl_year,
            available_response=available,
        )
    )
    source_preflight["sources"]["USGS_NAIP"]["catalog"] = (
        naip_validation
    )

    resolutions: list[float] = []
    for feature in features:
        attributes = feature.get("attributes", {})
        try:
            resolution = float(attributes.get("resolution_value"))
        except (TypeError, ValueError):
            continue
        units = str(attributes.get("resolution_units", "")).lower()
        if resolution > 0 and (
            not units or units.startswith("m") or "meter" in units
