if needs_naip:
    naip_metadata = require_source_coverage(
        lambda: service_metadata(NAIP, "naip", "USGS_NAIP")
    )
    source_preflight["sources"]["USGS_NAIP"] = {
        "service_extent": require_source_coverage(
            lambda: validate_service_extent(
                naip_metadata,
                (WEST, SOUTH, EAST, NORTH),
                source="USGS_NAIP",
            )
        )
    }
    naip_catalog = require_source_coverage(
        lambda: source_request_json(
        NAIP.rstrip("/") + "/query",
        {
            "where": f"Year = {ARGS.cdl_year}",
            "geometry": {
                "xmin": WEST,
                "ymin": SOUTH,
                "xmax": EAST,
                "ymax": NORTH,
                "spatialReference": {"wkid": 4326},
            },
            "geometryType": "esriGeometryEnvelope",
            "inSR": "4326",
            "spatialRel": "esriSpatialRelIntersects",
            "outFields": (
                "OBJECTID,Name,Year,acquisition_date,"
