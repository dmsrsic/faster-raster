if "natural" in requested_assets:
    reports.append(
        download_source_layer("USGS_NAIP",
            name="naip_natural",
            endpoint=NAIP,
            resolution=native_resolution,
            max_width=int(naip_metadata.get("maxImageWidth", 4000)),
            max_height=int(naip_metadata.get("maxImageHeight", 4000)),
            rendering_rule={"rasterFunction": "NaturalColor"},
            mosaic_rule=naip_rule,
            time_value=None,
            interpolation="RSP_BilinearInterpolation",
            destination=natural,
        )
    )

if "ndvi" in requested_assets:
    reports.append(
        download_source_layer("USGS_NAIP",
            name="naip_ndvi",
            endpoint=NAIP,
            resolution=native_resolution,
            max_width=int(naip_metadata.get("maxImageWidth", 4000)),
            max_height=int(naip_metadata.get("maxImageHeight", 4000)),
            rendering_rule={"rasterFunction": "NDVI_Color"},
            mosaic_rule=naip_rule,
            time_value=None,
            interpolation="RSP_BilinearInterpolation",
            destination=ndvi,
        )
    )

if "hillshade" in requested_assets:
    reports.append(
        download_source_layer("USGS_3DEP",
            name="three_dep_hillshade",
            endpoint=THREEDEP,
            resolution=10.0,
            max_width=int(dep_metadata.get("maxImageWidth", 8000)),
            max_height=int(dep_metadata.get("maxImageHeight", 8000)),
            rendering_rule={"rasterFunction": "Hillshade Gray"},
            mosaic_rule=None,
            time_value=None,
            interpolation="RSP_BilinearInterpolation",
            destination=hillshade,
        )
    )

if "cdl_classes" in requested_assets:
    reports.append(
        download_source_layer("USDA_CDL",
            name="cdl_raw",
            endpoint=CDL,
            resolution=30.0,
            max_width=int(cdl_metadata.get("maxImageWidth", 4097)),
            max_height=int(cdl_metadata.get("maxImageHeight", 4097)),
            rendering_rule=None,
            mosaic_rule=cdl_rule,
            time_value=f"{year_start},{year_end}",
            interpolation="RSP_NearestNeighbor",
            destination=cdl_raw,
        )
    )

if "cdl_color" in requested_assets:
    reports.append(
        download_source_layer("USDA_CDL",
            name="cdl_color",
            endpoint=CDL,
            resolution=30.0,
            max_width=int(cdl_metadata.get("maxImageWidth", 4097)),
            max_height=int(cdl_metadata.get("maxImageHeight", 4097)),
            rendering_rule={"rasterFunction": "croptypes"},
            mosaic_rule=cdl_rule,
            time_value=f"{year_start},{year_end}",
            interpolation="RSP_NearestNeighbor",
            destination=cdl_color,
        )
    )

if cdl_raw.is_file():
    write_class_counts(cdl_raw)

inspection: Path | None = None
if not ARGS.asset_only:
    inspection = create_preview(
        natural,
        ndvi,
        hillshade,
        cdl_raw,
        native_resolution=native_resolution,
        layer_reports=reports,
    )

for report in reports:
    source = TRAY / report["output"]
    info = run(["gdalinfo", "-json", str(source)], capture=True)
    write_json(
        VERIFY / f"{source.stem}_gdalinfo.json",
        normalize_gdalinfo_paths(json.loads(info), TRAY),
    )

manifest = {
    "schema_version": 2 if ARGS.asset_only else 1,
    "operation_status": (
        "asset_acquisition_partial" if ARGS.asset_only else "completed"
    ),
    "verification_status": "PASS",
    "order": {
        "name": ARGS.name,
        "bbox_epsg_4326": [WEST, SOUTH, EAST, NORTH],
        "time_start": ARGS.start,
        "time_end": ARGS.end,
        "cdl_year": ARGS.cdl_year,
        "portion": ARGS.portion,
        "network_ceiling_bytes": ARGS.max_total_bytes,
        "requested_assets": sorted(requested_assets),
    },
    "aoi_safety": AOI_SAFETY,
    "source_preflight": source_preflight,
    "naip": {
        "requested_year": ARGS.cdl_year,
        "catalog_match_count": len(features),
        "catalog_resolution_meters": catalog_native_resolution,
        "output_resolution_meters": native_resolution,
        "catalog_features": features,
    },
    "layers": reports,
    "network_bytes": network_bytes,
    "requests": request_receipts,
    "inspection_preview": (
        {
            "path": str(inspection.relative_to(TRAY)),
            "width": ARGS.preview_width,
            "height": round(ARGS.preview_width * 9 / 16),
            "sha256": sha256_file(inspection),
        }
        if inspection is not None
        else None
    ),
    "blocking_failures": [],
    "completed_at_utc": datetime.now(timezone.utc).isoformat(),
}
write_json(TRAY / "manifest.json", manifest)

shutil.rmtree(WORK, ignore_errors=True)

if ARGS.asset_only:
    print()
    print("SELECTIVE ASSET ACQUISITION: PASS")
    print("assets:", ", ".join(sorted(requested_assets)))
    print("network consumed:", f"{network_bytes:,}")
    print("staging:", TRAY)
    print("manifest:", TRAY / "manifest.json")
else:
    README = f"""# FasterRaster Agricultural Study

## Crop-cookie

`[{WEST}, {SOUTH}, {EAST}, {NORTH}]` in EPSG:4326.

## Timeframe

- Growing season: {ARGS.start} through {ARGS.end}
- USDA CDL thematic year: {ARGS.cdl_year}
- NAIP imagery selection: catalog records where Year = {ARGS.cdl_year}

## Handoff data

- `{natural.name}`
- `{ndvi.name}`
- `{hillshade.name}`
- `{cdl_raw.name}`
- `{cdl_color.name}`

## Execution envelope

- Portion: {ARGS.portion}
- Source-derived NAIP resolution: {native_resolution:g} meters
- Maximum network bytes: {ARGS.max_total_bytes:,}
- Actual network bytes: {network_bytes:,}
"""
    (TRAY / "README.md").write_text(README, encoding="utf-8")

    checksum_path = TRAY / "checksums.sha256"
    with checksum_path.open("w", encoding="utf-8") as stream:
        for path in sorted(TRAY.rglob("*")):
            if path.is_file() and path != checksum_path:
                stream.write(
                    f"{sha256_file(path)}  {path.relative_to(TRAY)}\n"
                )

    archive = TRAY.with_suffix(".tar")
    with tarfile.open(archive, "w") as tar:
        tar.add(TRAY, arcname=TRAY.name)
    archive_checksum = archive.with_suffix(".tar.sha256")
    archive_checksum.write_text(
        f"{sha256_file(archive)}  {archive.name}\n",
        encoding="utf-8",
    )

    if (
        ARGS.open
        and inspection is not None
        and shutil.which("explorer.exe")
        and shutil.which("wslpath")
    ):
        windows_path = run(
            ["wslpath", "-w", str(inspection)],
            capture=True,
        ).strip()
        subprocess.Popen(
            ["explorer.exe", windows_path],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

    print()
    print("================================================")
    print("AGRICULTURAL COOK: PASS")
    print("================================================")
    print("crop-cookie:", [WEST, SOUTH, EAST, NORTH])
    print("timeframe:", ARGS.start, "through", ARGS.end)
    print("CDL year:", ARGS.cdl_year)
    print("NAIP resolution:", native_resolution, "meters")
    print("network ceiling:", f"{ARGS.max_total_bytes:,}")
    print("network consumed:", f"{network_bytes:,}")
    print("tray:", TRAY)
    print("archive:", archive)
    print("inspection:", inspection)
    print("manifest:", TRAY / "manifest.json")
    print("checksums:", checksum_path)
