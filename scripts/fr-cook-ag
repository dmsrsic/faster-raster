    catalog_native_resolution = min(resolutions) if resolutions else 0.6
    native_resolution = (
        ARGS.naip_resolution
        if ARGS.naip_resolution is not None
        else catalog_native_resolution
    )
    if native_resolution <= 0:
        raise SystemExit("NAIP output resolution must be positive")
    if native_resolution < catalog_native_resolution:
        raise SystemExit(
            "Requested NAIP resolution is finer than the catalog source"
        )
    naip_rule = {
        "mosaicMethod": "esriMosaicAttribute",
        "where": f"Year = {ARGS.cdl_year}",
        "sortField": "Year",
        "sortValue": str(ARGS.cdl_year),
        "ascending": True,
        "mosaicOperation": "MT_FIRST",
    }

if needs_terrain:
